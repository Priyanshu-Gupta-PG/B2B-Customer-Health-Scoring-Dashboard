PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://health_user:health_password@localhost:5432/health_db
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Optional. If omitted in development, RSA keys are generated into .dev-keys/.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# OAuth client ID from Google Cloud (same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
# Comma-separated emails that should be administrators. The first Google signup is an admin when none exist yet.
GOOGLE_ADMIN_EMAILS=

BCRYPT_COST=12
INGEST_CRON=*/15 * * * *
SNAPSHOT_CRON=0 0 * * *
SEED_ACCOUNT_COUNT=150
