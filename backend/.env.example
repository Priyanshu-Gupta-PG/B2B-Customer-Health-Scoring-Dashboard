PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://health_user:health_password@localhost:5432/health_db
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Optional. If omitted in development, RSA keys are generated into .dev-keys/.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

BCRYPT_COST=12
INGEST_CRON=*/15 * * * *
SNAPSHOT_CRON=0 0 * * *
SEED_ACCOUNT_COUNT=150

# Dummy data websites (see mock-sources/). Leave defaults for local demo.
# For production, point these at the three Vercel mock deployments.
STRIPE_MOCK_URL=http://localhost:4101
ZENDESK_MOCK_URL=http://localhost:4102
PRODUCT_MOCK_URL=http://localhost:4103
