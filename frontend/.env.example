# Base URL of the Express API (API-B2B-01). /health is derived from the origin of this URL.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# When "true", the browser intercepts API calls with MSW mock handlers (src/mocks).
# Set to "false" once the Express backend is running (recommended — scores come from the API).
NEXT_PUBLIC_USE_MOCKS=false

# Mock data websites used when NEXT_PUBLIC_USE_MOCKS=true (and by the backend by default).
NEXT_PUBLIC_STRIPE_MOCK_URL=https://ledger-wire-stripe-mock.vercel.app
NEXT_PUBLIC_ZENDESK_MOCK_URL=https://desk-relay-zendesk-mock.vercel.app
NEXT_PUBLIC_PRODUCT_MOCK_URL=https://signal-meter-product-mock.vercel.app
