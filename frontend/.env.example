# Base URL of the Express API (API-B2B-01). /health is derived from the origin of this URL.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# When "true", the browser intercepts API calls with MSW mock handlers (src/mocks).
# Set to "false" once the Express backend is running.
# Google sign-up always calls the API at NEXT_PUBLIC_API_URL and is not mocked.
NEXT_PUBLIC_USE_MOCKS=true

# OAuth client ID from Google Cloud. Required for the sign-up button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
